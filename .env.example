# Docker 部署配置（复制为 .env）
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 镜像仓库与版本（自建仓库可设置 ARTEX_IMAGE=registry.example.com/project/artex）
ARTEX_IMAGE=ghcr.io/rc-chn/artex
ARTEX_TAG=latest

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
