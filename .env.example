# Docker 部署配置（复制为 .env）
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 镜像仓库与版本（自建仓库可设置 ARTEX_IMAGE=registry.example.com/project/artex）
ARTEX_IMAGE=ghcr.io/rc-chn/artex
ARTEX_TAG=latest

# 可选动态 Runner 池（--profile runners），硬并发上限见 deploy/runner/compose.json。
# Docker daemon 所在宿主机的绝对目录；每套部署须使用独立目录/网络。
ARTEX_RUNNER_DATA_DIR=/var/lib/artex-runner
ARTEX_RUNNER_NETWORK=artex-runners
ARTEX_RUNNER_SERVER_URL=http://artex:8787
ARTEX_RUNNER_TOKEN_FILE=./deploy/private/runner.enrollment

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
